{
  "name": "ascend",
  "private": true,
  "version": "1.0.0",
  "description": "A local-first, offline productivity RPG: turn real goals into campaigns, questlines and quests with a deterministic planning engine, XP, skill trees and analytics.",
  "keywords": [
    "productivity",
    "rpg",
    "gamification",
    "task-manager",
    "planner",
    "pwa",
    "offline-first",
    "local-first",
    "react",
    "typescript",
    "indexeddb"
  ],
  "homepage": "https://its-harsh-here.github.io/ASCEND/",
  "repository": {
    "type": "git",
